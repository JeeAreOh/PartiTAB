{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartiTAB",
  "version": "../package.json",
  "identifier": "com.partitab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PartiTAB",
        "width": 1100,
        "height": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/capas/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/collections/": "collections/"
    },
    "publisher": "Gefferson Oliveira",
    "shortDescription": "Leitor de partitura e prática de piano",
    "category": "Music",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
